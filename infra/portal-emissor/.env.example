# EMISSOR DO PORTAL, variaveis de ambiente (lado SERVIDOR). §A.6: nada aqui vai para log.
# Coordenar com o backend do EA: os quatro pares abaixo tem de casar com o que o cliente manda.

# Onde o emissor escuta. Loopback de proposito: a excecao `http` do cliente so vale para
# 127.0.0.1 / ::1 / localhost. A porta e combinada com o devops (ele seta PORTAL_EMISSOR_URL no EA).
PORTAL_EMISSOR_LISTEN_HOST=127.0.0.1
PORTAL_EMISSOR_LISTEN_PORT=8030

# A CHAVE PUBLICA DO EA (SPKI PEM, ou o PEM em base64 numa linha). E o PAR de
# PORTAL_EMISSOR_BILHETE_PRIVATE_KEY do backend. Sem ela o emissor fica INERTE (recusa tudo).
# Alternativa: PORTAL_EMISSOR_EA_PUBLIC_KEY_FILE apontando para o .pem.
PORTAL_EMISSOR_EA_PUBLIC_KEY=
PORTAL_EMISSOR_EA_PUBLIC_KEY_FILE=

# O balde do qual este emissor e autoritativo. TEM de ser igual ao PORTAL_GCS_BUCKET do EA:
# bilhete com balde diferente e recusado.
PORTAL_EMISSOR_BUCKET=

# A SA de ASSINATURA (arquivo JSON da service account que SO CRIA objeto). Sem ela,
# `assinar-escrita` recusa com erro generico (fail-closed). Provisionada pelo Rike no GCP.
PORTAL_EMISSOR_SIGNER_SA_FILE=

# A SA de CURADORIA (le/corrige/apaga). Identidade SEPARADA da de assinatura (B2/B3). Opcional
# para a demo do envio; sem ela, so metadado/corrigir-tipo/apagar ficam inertes.
PORTAL_EMISSOR_CURADORIA_SA_FILE=

# Tetos reimpostos pelo emissor (condicoes B1/B4). Defaults ja seguros.
PORTAL_EMISSOR_TETO_SEGUNDOS=600
PORTAL_EMISSOR_MAX_BYTES=10485760
