{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/enviar",
        "function": { "functionId": "enviarVt", "region": "us-central1" }
      },
      { "source": "/vt", "destination": "/index.html" },
      { "source": "/vt/**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" }
        ]
      },
      {
        "source": "/tarifas.json",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=300" }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "python312"
  }
}
