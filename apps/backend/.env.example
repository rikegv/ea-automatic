# EA AUTOMATIC — backend. Copie para apps/backend/.env e ajuste. (.env é git-ignored)

# Banco (ea-db, isolado do CentraAtend — porta 5433)
DATABASE_URL=postgres://ea:troque-este-segredo@127.0.0.1:5433/ea_automatic

# JWT HS256 (use segredos longos e aleatórios em qualquer ambiente real)
JWT_ACCESS_SECRET=troque-access-secret
JWT_REFRESH_SECRET=troque-refresh-secret
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# Cookie do refresh token
COOKIE_SECURE=false

# CORS / OriginGuard — origens permitidas (frontend local + endereços internos de acesso).
# Lista EXATA, sem wildcard: cada endereço pelo qual o time abre o EA precisa estar aqui, senão o
# login é recusado com "Origin não permitida" (§A.6: nunca liberar host genérico).
#   10.18.117.235:3010 = VPN antiga · 192.168.1.22:3010 = eth0 interno da VM (VPN nova)
ALLOWED_ORIGINS=http://127.0.0.1:3010,http://localhost:3010,http://10.18.117.235:3010,http://192.168.1.22:3010

# Porta da API (namespace EA)
BACKEND_PORT=3011

# Seed do admin inicial (SEM senha hardcoded no código — vem daqui)
EA_ADMIN_NOME=Administrador EA
EA_ADMIN_EMAIL=admin@ea.local
EA_ADMIN_PASSWORD=troque-no-primeiro-acesso

# Pandapé (INT-1 / Fase 5) — OAuth2 client_credentials (IdentityServer).
# CLIENT_ID/CLIENT_SECRET são INSUMO DO DIRETOR (§A.9) e vivem só na VM (apps/backend/.env,
# git-ignored) — NUNCA versionados, NUNCA logados/persistidos (§A.6). AMBOS VAZIOS = integração
# pronta porém INERTE: o job/tick roda mas não emite token nem chama o Pandapé (INÉRCIA, não erro).
PANDAPE_CLIENT_ID=
PANDAPE_CLIENT_SECRET=
# Endpoint de emissão do token (POST x-www-form-urlencoded). Default oficial abaixo.
PANDAPE_TOKEN_URL=https://login.pandape.com.br/connect/token
# Base da API v1 do Pandapé (chamadas usam Bearer <access_token>).
PANDAPE_API_BASE_URL=https://api.pandape.com.br

# Clicksign (INT-4 / assinatura)
# CLICKSIGN_API_TOKEN é INSUMO DO DIRETOR (§A.9) e vive só na VM (apps/backend/.env,
# git-ignored) — NUNCA versionado. Sem token, a integração fica pronta porém INERTE:
# o cron (infra/install-clicksign-cron.sh) dispara o tick e o endpoint responde, mas
# nada é enviado/baixado da Clicksign. É INÉRCIA, não mock (paridade com o commit 82c986e).
# Auth: header `Authorization: <token>`, content-type application/vnd.api+json.
CLICKSIGN_API_TOKEN=
# Sandbox por padrão; em produção use https://app.clicksign.com/api/v3 (confirme com o diretor).
# Os dois ambientes são CONTAS SEPARADAS: token de sandbox não vale em produção e vice-versa.
# Procedimento completo da virada: infra/VIRADA-CLICKSIGN-PRODUCAO.md
CLICKSIGN_API_BASE_URL=https://sandbox.clicksign.com/api/v3

# Redis (ea-redis, isolado do CentraAtend — porta 6380) — fila BullMQ + rate-limit
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# Link assinado do formulário de VT (§A.17). Assinatura Ed25519 (alg EdDSA): o EA assina com a
# chave PRIVADA, o app externo (Firebase) verifica OFFLINE só com a PÚBLICA. Gere o par com
# `pnpm exec tsx scripts/gen-vt-link-keys.ts` (a saída traz a privada em base64 e a pública p/ o app).
# VT_LINK_PRIVATE_KEY é PEM PKCS8 codificado em base64 (uma linha). VAZIA = gerador INERTE: o
# endpoint /vt-coleta/admissao/:id/gerar-link responde 503, o app segue no ar. §A.6: NUNCA versionar
# nem logar a chave. VT_LINK_TTL_DIAS: validade do link em dias (default 7). VT_LINK_BASE_URL: base
# do app do VT (default https://vt-online-soulan.web.app/vt).
VT_LINK_PRIVATE_KEY=
VT_LINK_TTL_DIAS=7
VT_LINK_BASE_URL=https://vt-online-soulan.web.app/vt

# Coleta de formulário de VT (§A.17 etapa 3): nome do BUCKET do GCS onde o app externo deposita os
# PDFs. O ai-service lê o bucket, casa cada PDF pelo CPF do nome do objeto e o EA arquiva no Drive.
# VAZIO = integração INERTE (a varredura bate o heartbeat com nota e não faz nada). §A.6: o nome do
# objeto no bucket contém NOME+CPF e é handle transitório, nunca persistido nem logado.
VT_COLETA_GCS_BUCKET=

# ── PORTAL DO CANDIDATO: A IDENTIDADE ──────────────────────────────────────────────────────────
# Dois PARES Ed25519, e a separação é o ponto (decisão 10 de
# `docs/DESENHO-PORTAL-REGRAS-DE-SEGURANCA.md`). Com UMA chave só para os dois bilhetes, o dia em
# que a conferência do claim `typ` cair numa refatoração, um link de 72 horas passa a valer como
# SESSÃO de 72 horas e nada falha. Com pares distintos, o mesmo descuido vira assinatura inválida.
#
# Formato: PEM PKCS8 em base64 (uma linha), o mesmo de VT_LINK_PRIVATE_KEY. Gere com
# `node -e "const{generateKeyPairSync}=require('node:crypto');const{privateKey,publicKey}=generateKeyPairSync('ed25519');console.log('priv',Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'));console.log('pub',Buffer.from(publicKey.export({type:'spki',format:'pem'})).toString('base64'))"`
#
# VAZIAS = portal INERTE, no molde do webhook do Pandapé: emitir link e identificar respondem 503 e
# o EA sobe normalmente. Não há fallback para o JWT_ACCESS_SECRET, e não pode haver.
# §A.6: NUNCA versionar, nunca logar. As chaves são credencial.
#
# A PÚBLICA DO LINK NÃO TEM VARIÁVEL: ela é derivada da privada dentro do serviço. Uma variável a
# menos para configurar errado, e uma pública que não fosse o par faria o EA recusar todo link que
# ele mesmo assinou.
PORTAL_LINK_PRIVATE_KEY=
PORTAL_SESSION_PRIVATE_KEY=
PORTAL_SESSION_PUBLIC_KEY=

# Base da URL que o consultor manda ao candidato. O token viaja no FRAGMENTO (`#t=`), que o
# navegador NÃO envia ao servidor: assim ele não aparece no log de acesso do proxy nem da barreira.
# VAZIA = base RELATIVA (`/portal`), que é visivelmente incompleta de propósito: o endereço externo
# depende do vhost da barreira (pendência de infra), e inventar um hostname aqui produziria um link
# que parece bom e não abre.
PORTAL_LINK_BASE_URL=

# ── PORTAL DO CANDIDATO: O CORREIO (envio do link por e-mail) ──────────────────────────────────
# Decisão do diretor: reusar a CONTA DE SERVIÇO que já existe no projeto `ea-v2-automatic` e a
# delegação de domínio que já roda em produção no Drive. O que falta é habilitar o escopo
# `https://www.googleapis.com/auth/gmail.send` para o client_id dela no Admin do Workspace e
# escolher a caixa remetente. As duas coisas são DESTRAVE DO DIRETOR, e por isso o canal NASCE
# INERTE: vazio = o envio RECUSA (`CANAL_INDISPONIVEL`) e, o que importa mais, NÃO EMITE O LINK.
# Emitir e não entregar deixaria credencial viva que ninguém recebeu, e ainda revogaria o link
# anterior de quem estivesse enviando documento naquele instante.
#
# NÃO HÁ FALLBACK e não há SMTP alternativo. Canal não configurado é recusa, nunca "envia depois".
#
# `PORTAL_CORREIO_SA_EMAIL`: o e-mail da conta de serviço (o `client_email` do JSON dela).
# `PORTAL_CORREIO_PRIVATE_KEY`: a chave privada RSA em PEM. Aceita `\n` literal (que é como ela
#   vem no JSON da conta de serviço) ou quebras de linha reais. §A.6: NUNCA versionar, nunca logar.
# `PORTAL_CORREIO_REMETENTE`: a CAIXA DELEGADA em nome de quem a conta de serviço envia, e é ela
#   que o candidato vê como remetente. Precisa ser uma caixa real do domínio, com a delegação
#   concedida; sem isso o Google responde `unauthorized_client` e nada sai.
# `PORTAL_CORREIO_TIMEOUT_MS`: vazio = 10000. Curto de propósito: o consultor está na tela
#   esperando o desfecho do clique.
PORTAL_CORREIO_SA_EMAIL=
PORTAL_CORREIO_PRIVATE_KEY=
PORTAL_CORREIO_REMETENTE=
PORTAL_CORREIO_TIMEOUT_MS=

# Pepper da trilha do Portal e do limitador de tentativas. SEGREDO PRÓPRIO (decisão 10), jamais o
# JWT_ACCESS_SECRET que o VT reaproveita. VAZIO = a trilha se RECUSA a gravar e o portal não emite
# link nem identifica: hash sem pepper sobre um CPF de 11 dígitos é quebrável em segundos, e seria
# teatro. §A.6.
PORTAL_LOG_PEPPER=

# ── PORTAL DO CANDIDATO: A PORTA DE E-MAIL (código de verificação) ──────────────────────────────
# Contrato: `docs/CONTRATO-PORTAL-ACESSO-EMAIL.md` (v2). A porta prova a POSSE DA CAIXA e, com isso,
# manda o LINK para aquela mesma caixa. Ela NÃO emite sessão e NÃO abre o Portal: a chave de acesso
# continua sendo link + CPF + nascimento em `POST portal/identificar`.
#
# `PORTAL_CODIGO_PEPPER`: o segredo do HMAC-SHA256 do código de 6 dígitos. VARIÁVEL PRÓPRIA, e
# JAMAIS o `PORTAL_LOG_PEPPER` acima: aquele deriva o `candidato_hash` da trilha, que gente do time
# lê, e com o segredo compartilhado quem enxerga um dos dois deriva o outro. O espaço do código é de
# UM MILHÃO de valores, então com o pepper em mãos um milhão de HMACs revela o código vivo de
# qualquer pessoa: é um laço, não uma quebra. §A.6.
#
# VAZIO = a porta responde 503 e NADA acontece (fail-closed, molde do webhook do Pandapé). E ela
# exige mais DUAS coisas já configuradas acima, pelo mesmo 503: o `PORTAL_LOG_PEPPER` (sem trilha
# não se concede nada) e o CORREIO (`PORTAL_CORREIO_*`, sem canal o código não chega a ninguém, e
# emitir código que ninguém recebe deixaria credencial viva sem dono).
#
# NÃO EXISTE, E NÃO PODE EXISTIR, variável que exponha o código fora do e-mail (condição C9): nem
# "modo de teste", nem "mostrar na resposta", nem em log, em nenhum ambiente, inclusive homologação.
PORTAL_CODIGO_PEPPER=

# ── Portal, limite de ritmo por IP das rotas anônimas (veto 2) ───────────────────────────────────
# `PORTAL_RITMO_SALTOS_CONFIAVEIS`: QUANTOS proxies NOSSOS existem entre o candidato e o backend.
# É com esse número que o `PortalRitmoGuard` conta o `x-forwarded-for` DA DIREITA PARA A ESQUERDA e
# acha o IP do cliente. Vazio ou zero = DESLIGADO: nenhum IP é tratado como confiável e sobra o teto
# da superfície (120 por minuto, o mesmo número do balde global de hoje, mas isolado da operação
# interna). Ligar por omissão seria confiar num cabeçalho forjável.
#
# MEDIDO EM 29/09/2026, com o binário e o Caddyfile de produção:
#  - o Caddy SEM `trusted_proxies` SOBRESCREVE o `x-forwarded-for` com o IP do peer e descarta o que
#    o cliente mandou. Hoje, com só o Caddy na frente, o valor certo aqui é 1;
#  - quando o Apache da barreira (192.168.1.174) entrar, ele precisa de DUAS coisas ao mesmo tempo:
#    `servers { trusted_proxies static 192.168.1.174/32 }` no Caddyfile do EA (senão o Caddy apaga o
#    IP do candidato e só resta o do Apache) e este número em 2;
#  - pelo Next (rewrites, homologação :3120) o `x-forwarded-for` do CLIENTE chega intacto e em
#    primeiro lugar: naquele caminho o valor é forjável, e é por isso que a variável nasce vazia.
PORTAL_RITMO_SALTOS_CONFIAVEIS=
#
# `PORTAL_RITMO_PROXY_ESPERADO`: CSV dos IPs que PODEM aparecer como o proxy mais à DIREITA do
# `x-forwarded-for`. É a ÂNCORA da topologia, e sem ela NADA é confiável (vazia = derivação
# desligada, mesmo com os saltos declarados). Ela existe porque contar o enésimo da direita sem
# conferir quem escreveu o último falha entregando um IP ERRADO em vez de nenhum: saltos
# sobre-declarado devolve o valor que o ATACANTE escreveu (e ele envenena o balde de um terceiro),
# e sub-declarado colapsa todos os candidatos num balde só. Com a âncora, os dois viram `null`.
# Hoje, com só o Caddy na frente, o valor é `127.0.0.1`; com o Apache da barreira, `192.168.1.174`.
PORTAL_RITMO_PROXY_ESPERADO=
#
# `PORTAL_RITMO_BORDA_SEGREDO`: OPCIONAL, e quando declarado passa a ser OBRIGATÓRIO (fail-closed):
# a requisição só tem IP confiável se trouxer `x-portal-borda` com este valor. É o item F1 do
# desenho, e é o ÚNICO conserto que fecha o terceiro desvio: se a barreira for apontada para a
# porta do Next em vez da do Caddy (o molde do pacote do VT, então é o erro provável), o Next
# repassa o `x-forwarded-for` do cliente INTACTO e a lista inteira vira escolha do visitante, com
# âncora e tudo. Enquanto vazio, o que segura o terceiro desvio é a disciplina de apontar a
# barreira para a porta certa.
PORTAL_RITMO_BORDA_SEGREDO=

# ── Portal→GI (peça 3) ──────────────────────────────────────────────────────────────────────────
# O EA "manda a pessoa para a folha" (G.I) por FuncionarioSelecao (pré-admissão), nunca em
# Funcionario (a folha oficial). AUTH DE DUAS ETAPAS: VerificaConexao {IDClienteWeb, ChaveAcesso}
# devolve o token1; Login/Login (Bearer token1) {login, senha} devolve o token2 (~2h). Sem a URL E
# os QUATRO campos da credencial, `GiApiService.configurado()` diz não, `EnviarParaGiService` é no-op
# e nada toca a rede (fail-closed).
#
# §A.6 (LEIA): estes quatro campos são CREDENCIAL. NUNCA versione valores reais aqui nem em log; eles
# vivem só no `apps/backend/.env` da VM. A URL/host/token do GI nunca são persistidos nem logados.
GI_API_URL=https://apigeral.gi.app.br/api/v1
GI_ID_CLIENTE_WEB=
GI_CHAVE_ACESSO=
GI_LOGIN=
GI_SENHA=
# TRAVA DO DISPARO: o envio real (POST FuncionarioSelecao/Add) só ocorre com GI_DISPARO_ARMADO=true.
# Vazio/qualquer-outra-coisa = DESARMADO: o gatilho manual monta o payload e PARA, sem criar no GI.
GI_DISPARO_ARMADO=
# DE/PARA de código de município (JSON), chave "UF|CIDADE". Sem ele, o código de cidade fica vazio no
# payload (fail-closed). Valores reais só na VM (o mapa real tem 5.571 chaves e não cabe aqui).
# Ex.: GI_DEPARA_CIDADES={"SP|SAO PAULO":"3550308","SP|CAMPINAS":"3509502"}
#
# ⚠️ O EXEMPLO ANTIGO AQUI DIZIA "SP|SAO PAULO":"7107", E ISSO ERA UMA ARMADILHA: `7107` nunca foi
# medido contra nada, veio de fixture, e São Paulo no IBGE é `3550308`. Quem copiasse o exemplo
# montaria um mapa de OUTRO espaço de código, e o GI gravaria a cidade errada em silêncio. Corrigido
# em 02/10/2026 com os códigos IBGE reais (tabela pública, 5.571 municípios, 27 UFs).
#
# ⚠️ O ESPAÇO DO CÓDIGO NÃO É O MESMO NOS DOIS CAMPOS QUE ESTE MAPA ALIMENTA, e isto não está fechado:
#   - `codMunicipioNascto` (município de NASCIMENTO) é IBGE. PROVADO: o GI guardou `3509502` para
#     Campinas no registro 27 (rodada 4, 02/10/2026), e é o padrão do eSocial.
#   - `codigoCidadeResid` (cidade de RESIDÊNCIA) tem espaço DESCONHECIDO. `DePara/GetAll` do GI
#     devolve 0 itens, `FuncionarioSelecao/GetAll` esvazia em menos de 10 min e `ApiFicha` responde
#     403, então não há de onde ler o par (cidade texto -> código) hoje.
# Enquanto for UM mapa só (`domain/portal-dados-gi.ts`, `codigoCidade` serve os dois), preencher
# resolve os DOIS. Ver `docs/MAPA-GI-FECHAR-A-PONTE.md`, seção 0.
# GI_DEPARA_BANCOS saiu em 01/10/2026: `codigoBcoFolha`/`codigoBcoPagar` referenciam a CONTA PAGADORA
# da empresa (catálogo `TB_Banco`, com agência/conta/cheque/saldo), quem cadastra é o time de folha e o
# EA não envia mais os campos, então o mapa ficou sem consumidor.
GI_DEPARA_CIDADES=
# LISTA AUTORITATIVA DOS PARES (EMPRESA, FILIAL) do GI, materializada OFFLINE de `Empresa/GetAll` (127
# pares, medidos em 01/10/2026). `codigoEmpresa` e `codigoFilial` são os dois únicos campos `int16`
# OBRIGATÓRIOS e SEM default do envio, e validar os dois em separado NÃO BASTA: `1|37` é numericamente
# válido nos dois campos e não existe no fornecedor. Dos 244 vínculos do EA, 243 casam com um par real.
# FAIL-CLOSED: sem esta lista, NENHUM par é conhecido e TODO envio ao GI é recusado
# (`GI_PAR_EMPRESA_FILIAL_DESCONHECIDO`). Nunca se envia par não verificado.
# Três formas aceitas: ["1|0","1|4"] · [[1,0],[1,4]] · {"1":[0,4],"2":[0]}
# ⚠️ FILIAL 0 É LEGÍTIMA (existe para todas as 47 empresas), então "1|0" é par válido, não ausência.
GI_PARES_EMPRESA_FILIAL=
# Caminho do endpoint de criação, sobrescrevível se o verbo exato do swagger divergir. Default abaixo.
GI_FUNCIONARIO_SELECAO_PATH=/FuncionarioSelecao/Add

# ── Digai (ATS de triagem, INT nova) ────────────────────────────────────────────────────────────
# A INTEGRACAO NASCE INERTE, e sao TRES portoes independentes. Nenhum deles tem default, e nenhum
# deles e redundante com os outros:
#
# `DIGAI_API_TOKEN`: o BEARER pronto (uma API key por organizacao; NAO ha OAuth, e residuo de
#   `client_secret`/`grant_type` e acusado pela inspecao da grade). VAZIO = nada SAI para a rede: o
#   `DigaiCliente` diz `ativo: false` e a leitura lanca antes do `fetch`. §A.6: valor real so no
#   `.env` da VM, nunca aqui, nunca em log, nunca em commit. Ele FOI EXPURGADO (`shred`) em 16/09.
#
# `DIGAI_WEBHOOK_TOKEN`: a auth de ORIGEM do receptor `POST /api/webhooks/digai`, conferida contra o
#   header `x-digai-webhook-token` em tempo constante. VAZIO = a rota responde 401 (fail-closed).
#   TOKEN-ONLY, UM MECANISMO SO: NAO existe `DIGAI_WEBHOOK_IPS`, e a ausencia e deliberada. A
#   allowlist de IP do Pandape existe la por causa do NAT do box do Fernando, e um segundo caminho
#   de autorizacao aqui seria uma chance a mais de um deles ficar frouxo sem o outro acusar.
#
# `DIGAI_INGESTAO_ATIVA`: o SEGUNDO portao, e ele e o que protege o BANCO. Vazio, ausente ou
#   qualquer coisa diferente de `true` = a ingestao LE e NAO ESCREVE, mesmo com credencial valida.
#   O universo do outro lado e de 12.445 pessoas: integracao que comeca a escrever no dia em que o
#   token chega nao foi LIGADA, foi SURPREENDIDA. So `true` liga.
#
# `DIGAI_POLLING_ATIVO`: o TERCEIRO portao, e ele e o da CONSULTA PERIODICA (o caminho VIGENTE desde
#   29/09/2026, decisao do diretor). Vazio, ausente ou qualquer coisa diferente de `true` = o
#   scheduler NAO dispara e a rota `POST /internal/digai/tick` nao enfileira nada. Ele e separado
#   dos outros dois porque decide coisa diferente: token e "pode sair para a rede", ingestao e "pode
#   escrever no banco", e este e "pode varrer sozinho, em cadencia, sem ninguem pedir". Um ciclo
#   varre ~523 requisicoes (1 listagem + 522 screenings medidos), a cada 30 min, sob o limiter de
#   90 req/min: nao e a mesma decisao que escrever o que um evento trouxer. So `true` liga.
#
# O WEBHOOK FICA NO LUGAR E NAO FOI REMOVIDO: ele funciona e e opcao futura, bastando o cadastro do
# listener no painel do fornecedor (pelo Ivan). Com o polling vigente, `DIGAI_WEBHOOK_TOKEN` DEIXOU
# DE SER NECESSARIO PARA OPERAR: vazio, o receptor segue fail-closed e inerte, e a ingestao roda
# igual pela varredura.
DIGAI_API_TOKEN=
DIGAI_WEBHOOK_TOKEN=
DIGAI_INGESTAO_ATIVA=
DIGAI_POLLING_ATIVO=
