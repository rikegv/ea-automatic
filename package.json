{
  "name": "ea-automatic",
  "private": true,
  "version": "0.0.0",
  "description": "EA AUTOMATIC — esteira admissional do Grupo Soulan (monorepo)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20 <21",
    "pnpm": ">=9"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "ajuda:capturar": "LD_LIBRARY_PATH=/home/henrique/.ea-harness/libs/root/usr/lib/x86_64-linux-gnu apps/backend/node_modules/.bin/tsx tools/ajuda/src/bin/capturar.ts",
    "ajuda:conferir": "LD_LIBRARY_PATH=/home/henrique/.ea-harness/libs/root/usr/lib/x86_64-linux-gnu apps/backend/node_modules/.bin/tsx tools/ajuda/src/bin/conferir.ts",
    "ajuda:cobertura": "LD_LIBRARY_PATH=/home/henrique/.ea-harness/libs/root/usr/lib/x86_64-linux-gnu apps/backend/node_modules/.bin/tsx tools/ajuda/src/bin/cobertura.ts",
    "ajuda:registro": "apps/backend/node_modules/.bin/tsx tools/ajuda/src/bin/registro.ts",
    "ajuda:typecheck": "tsc -p tools/ajuda/tsconfig.json",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file infra/.env up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file infra/.env down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
