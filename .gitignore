# dependencies
node_modules/
.pnpm-store/

# build output
dist/
.next/
# Builds ANTERIORES guardados para reverter em um comando (`mv dist.old dist`). Artefato de máquina,
# nunca versionado: sem estas linhas eles aparecem no `git status`, e um `git add .` distraído
# levaria 108 MB de build do frontend para o repositório.
dist.old/
.next.old/
# Mesma coisa, com o nome usado no deploy do frontend: 132 MB que apareciam no `git status` e
# entrariam num `git add .` distraído, exatamente o acidente que o comentário acima descreve.
.next.deploy-old/
dist.new/
out/
*.tsbuildinfo

# test / coverage
coverage/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# env / secrets (keep *.example tracked)
.env
.env.local
.env.*.local
infra/.env

# google service account credential (INT-2 Drive + INT-3 Vertex AI) — NEVER commit
credentials.json
apps/ai-service/credentials.json

# python (ai-service)
__pycache__/
*.py[cod]
.venv/
apps/ai-service/.venv/
.uv/
.pytest_cache/
.ruff_cache/

# deploy gate — READY flags are local & deliberate, never committed
.claude/state/READY_*

# os / editor
.DS_Store
.idea/
*.swp

# artefato de demo (PDF-mãe do kit F9) — não versionar
apps/frontend/public/demo-kit-pdf-mae.pdf

# amostra do relatório da clínica — gerada localmente, pode conter CNPJ de cliente (§A.6); não versionar
relatorio-clinica-exemplo.csv

# base de dados de clientes (planilha de insumo, contém dados de cliente §A.6); fica só em disco, não versionar
/BASE ATUALIZADA CLIENTES 07-07.xlsx

# Insumos de dados (planilhas e extrações): podem conter CPF e dados pessoais de candidato (§A.6).
# Regra genérica, para que toda planilha futura nasça protegida sem depender de lembrar do nome.
# Ficam só em disco, na VM; nunca no repositório.
*.xlsx
*.csv
# Exceção: bases de carga versionadas de propósito (dados de cliente/régua, sem dado pessoal),
# consumidas pelos seeds do backend.
!apps/backend/src/db/data/*.csv
